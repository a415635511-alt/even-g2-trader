{
  "name": "even-g2-trader",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Heads-up read-and-write trading & prediction market copilot for Even Realities G2 smart glasses",
  "scripts": {
    "server": "node server/index.mjs",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "pack": "npm run build && evenhub pack app.json dist",
    "simulate": "evenhub-simulator --automation-port 9898 http://localhost:5173",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@evenrealities/even_hub_sdk": "^0.0.10"
  },
  "devDependencies": {
    "@evenrealities/evenhub-cli": "^0.1.12",
    "@evenrealities/evenhub-simulator": "^0.7.2",
    "typescript": "^5.7.0",
    "vite": "^5.4.0"
  }
}
